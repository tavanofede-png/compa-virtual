# Server/worker only. Do not put these secrets in NEXT_PUBLIC_ or EXPO_PUBLIC_ variables.
# Copy this file to `.env` at the repo root (gitignored) for local worker/API tooling.
# The worker also reads `apps/worker/.env` if present; Render injects process env, not files.

# --- IA compartida del proyecto ---
# Cloudflare Workers AI ofrece una asignación gratuita diaria para la prueba.
# Una sola clave de servidor atiende a todos los usuarios; nunca se expone al cliente.
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash
CLOUDFLARE_AI_EMBEDDING_MODEL=@cf/baai/bge-m3
CLOUDFLARE_AI_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
AI_VECTOR_DIMENSIONS=1536
# Alternativa paga para producción. Solo se usa cuando AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# The default voice is the free system voice; no audio is sent to OpenAI.
VOICE_PROVIDER=system
# Native microphone: authenticated Whisper only; never a paid transcription fallback.
VOICE_ENABLED=false
VOICE_MINOR_DATA_APPROVED=false
VOICE_STUDENT_DAILY_SECONDS=600
# Optional dedicated Free Cloudflare account. Otherwise uses the existing account.
CLOUDFLARE_VOICE_ACCOUNT_ID=
CLOUDFLARE_VOICE_API_TOKEN=
# Reserved for an optional paid speech-input phase. Disabled by default.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_ENABLED=false
AI_MONTHLY_BUDGET_USD=50
# Biblioteca: máximo 50 archivos por cuenta y este total de MiB. Cada archivo <=25 MB.
MATERIAL_STORAGE_QUOTA_MIB=250

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://compa-virtual-estudio.tavanofede.chatgpt.site,https://kusiy.vercel.app
# Shared by Edge Function `reminders` and Vault secret `compa_cron_secret`.
CRON_SECRET=
# Optional, if enhanced Expo push security is configured.
EXPO_ACCESS_TOKEN=
# Default fail closed: adults and fictional data only.
MINOR_BETA_APPROVED=false
# UUID de la cuenta operadora, separados por comas. El panel exige MFA AAL2.
OPERATOR_USER_IDS=
# Only after approved documents and a verified guardian procedure are available.
FAMILY_PORTAL_ENABLED=false
FAMILY_PORTAL_URL=https://kusiy.vercel.app/family
FAMILY_TERMS_URL=
FAMILY_PRIVACY_URL=
# Independent, adult-only social beta. Deploy the collaboration migration and API first.
COLLABORATION_ENABLED=false
SOCIAL_MINOR_BETA_APPROVED=false
SOCIAL_CHAT_ENABLED=false
SOCIAL_CHAT_MODERATION_READY=false
SOCIAL_CHAT_MINOR_APPROVED=false
OPENAI_ZDR_VERIFIED=false
AI_MINOR_DATA_APPROVED=false
DIGITAL_CONSENT_AGE=18
# Add verified USD per million token rates per model when configuring cost reporting.
# La asignación de prueba de Workers AI no genera costo. Al migrar a un plan
# pago, reemplazar estos ceros por las tarifas vigentes para conservar alertas.
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
AI_EMBEDDING_USD_PER_MILLION=0
