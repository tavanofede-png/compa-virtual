# Server/worker only. Do not put these secrets in NEXT_PUBLIC_ or EXPO_PUBLIC_ variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://compa-virtual-estudio.tavanofede.chatgpt.site
CRON_SECRET=
