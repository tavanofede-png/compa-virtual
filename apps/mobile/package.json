{
  "name": "@compa/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node node_modules/expo/bin/cli start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "export": "pnpm export:android && pnpm export:ios",
    "export:android": "node node_modules/expo/bin/cli export --platform android --output-dir dist-android --max-workers 2",
    "export:ios": "node node_modules/expo/bin/cli export --platform ios --output-dir dist-ios --max-workers 2"
  },
  "dependencies": {
    "@compa/client": "workspace:*",
    "@compa/domain": "workspace:*",
    "@compa/world3d": "workspace:*",
    "@expo/metro-runtime": "~57.0.15",
    "@react-three/fiber": "9.7.0",
    "expo": "57.0.20",
    "expo-asset": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-gl": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "19.2.14",
    "@types/three": "0.185.4",
    "typescript": "5.9.3"
  }
}
