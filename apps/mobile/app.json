{
  "expo": {
    "name": "Compa Virtual",
    "slug": "compa-virtual",
    "scheme": "compavirtual",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.compavirtual.estudio",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.compavirtual.estudio",
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      ["expo-notifications", { "defaultChannel": "study-reminders" }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
