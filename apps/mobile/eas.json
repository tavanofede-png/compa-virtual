{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "beta": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "beta"
    }
  },
  "submit": {
    "beta": {
      "android": {
        "track": "internal"
      },
      "ios": {}
    }
  }
}
